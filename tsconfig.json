{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@kazo-ca/css-properties": ["./packages/css-properties/src/index.ts"],
      "@kazo-ca/hierarchical-dom-tree": ["./packages/dom-tree/src/index.ts"],
      "@kazo-ca/html-designer": ["./packages/designer/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "fixtures/**/*.ts", "demo/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
