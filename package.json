{
  "name": "html-animation-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "build:demo": "vite build --config vite.config.ts",
    "dev": "vite --config vite.config.ts --host 127.0.0.1 --port 43127 --strictPort",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1 --port 43128 --strictPort",
    "test:e2e": "playwright test",
    "check:packages": "node scripts/check-packages.mjs",
    "generate:css-catalog": "node scripts/generate-css-catalog.mjs",
    "check:css-catalog": "node scripts/generate-css-catalog.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "less": "4.9.1",
    "mdn-data": "2.37.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
